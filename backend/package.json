{
  "name": "@avitronics/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build:shared": "tsc -p ../shared/tsconfig.json",
    "dev": "npm run build:shared && tsx watch src/index.ts",
    "build": "npm run build:shared && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "prisma db push --skip-generate && node dist/db/seed.js && node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:seed": "npm run build:shared && tsx src/db/seed.ts",
    "test": "npm run build:shared && vitest run"
  },
  "dependencies": {
    "@avitronics/shared": "0.1.0",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.12",
    "prisma": "^5.19.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
